    "A serene conversational space to reflect, breathe, unwind, and find focus amidst daily noise.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A serene conversational space to reflect, breathe, unwind, and find focus amidst daily noise."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在繁忙中深呼吸、沉淀思绪、解压放松并找回内在专注的宁静对话空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在繁忙中深呼吸、沉澱思緒、解壓放鬆並找回內在專注的寧靜對話空間。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
